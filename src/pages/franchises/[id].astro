---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FranchiseStory from '../../components/FranchiseStory.astro';
import { franchisePaths, franchiseProfile } from '../../lib/franchise-profile';
import '../../styles/franchise-detail.css';
export const getStaticPaths=franchisePaths;
const p=franchiseProfile(Astro.props.franchise);
const activeTeamId=Astro.props.franchise.activeTeamId;
---
<BaseLayout title={`${p.current?.name??`Franchise ${p.id}`} | AMD FFL`}><main class="franchise-detail">
<section class="franchise-hero"><div class="shell franchise-hero-grid"><div class="franchise-hero-copy"><a class="back" href="/franchises">← All Franchises</a><div class="eyebrow">Franchise F{String(p.id).padStart(2,'0')}</div><h1>{p.current?.name??`Franchise ${p.id}`}</h1><p>{p.lineage.length} {p.lineage.length===1?'identity':'identities'} across the archive. One franchise slot, every name change preserved.</p><div class="hero-stats"><div><strong>{p.wins.length}</strong><span>Championships</span></div><div><strong>{p.wins.length+p.losses.length}</strong><span>Cathedral Bowl Apps</span></div><div><strong>{p.lineage.length}</strong><span>Team Identities</span></div></div></div><div class="detail-helmet-stage"><div class="detail-helmet-ring"></div><div class="detail-helmet-placeholder">F{String(p.id).padStart(2,'0')}</div>{p.current&&<img class="detail-helmet-img" src={`/teams/${p.current.teamId}-helmet.webp`} alt={`${p.current.name} helmet`} onerror="this.style.display='none'" />}</div></div></section>
<section class="shell profile-grid"><FranchiseStory chapters={p.chapters}/><aside class="franchise-aside"><div class="card lineage-card"><div class="lineage-head"><span class="eyebrow">Identity Lineage</span><small>{p.lineage.length} total</small></div>{p.lineage.map((t:any,i:number)=><div class:list={['identity',{current:t.teamId===activeTeamId}]}><small>{String(i+1).padStart(2,'0')}</small><strong>{t.name}</strong>{t.teamId===activeTeamId&&<em>CURRENT</em>}</div>)}</div><div class="archive-note"><span>HELMET ARCHIVE</span><strong>Coming next</strong><p>Helmet art will drop into this franchise automatically using the active team ID filename convention.</p></div></aside></section>
</main></BaseLayout>
