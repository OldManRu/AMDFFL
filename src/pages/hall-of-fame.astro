---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/hall-of-fame.css';
import { hof } from '../lib/hof';
const years=[...new Set(hof.map((x:any)=>x.year))].sort((a:any,b:any)=>b-a);
---
<BaseLayout title="Hall of Fame | AMD FFL"><main class="hof-page">
<section class="page-head"><div class="shell hof-intro"><div class="eyebrow">Immortalized in the archive</div><h1>Hall of Fame</h1><p class="muted">The players who left enough damage behind to earn permanent residence here.</p></div></section>
<section class="shell hof-wrap">{years.map((year:any)=><section class="hof-year"><div class="year-head"><div class="year-badge"><div><small>Class of</small><strong>{year}</strong></div></div><div class="year-copy"><span>AMD FFL Hall of Fame</span><h2>Induction Class</h2></div></div><div class="hof-grid">{hof.filter((x:any)=>x.year===year).map((x:any)=><article class="card hof-card" data-pos={x.positionGroup}><div class="inductee-top"><div class="pos">{x.positionGroup}</div><div class="inducted">Permanent Residence</div></div><h3>{x.player}</h3><div class="credentials"><div class="credential"><strong>{x.points?.toLocaleString?.()??x.points}</strong><span>Career Points</span></div><div class="credential"><strong>{x.seasons}</strong><span>Seasons</span></div></div><p class="hof-source">{x.source}</p></article>)}</div></section>)}<div class="hof-footer">Once you're in, you're in. The archive has no release clause.</div></section>
</main></BaseLayout>