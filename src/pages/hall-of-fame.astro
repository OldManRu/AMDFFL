---
import BaseLayout from '../layouts/BaseLayout.astro';
import { hof } from '../lib/hof';
const years=[...new Set(hof.map((x:any)=>x.year))].sort((a:any,b:any)=>b-a);
---
<BaseLayout title="Hall of Fame | AMD FFL"><main><section class="page-head"><div class="shell"><div class="eyebrow">Immortalized in the archive</div><h1>Hall of Fame</h1><p class="muted">The players who left enough damage behind to earn permanent residence here.</p></div></section><section class="shell hof-wrap">{years.map((year:any)=><section class="hof-year"><div class="year-head"><span>Class of</span><h2>{year}</h2></div><div class="hof-grid">{hof.filter((x:any)=>x.year===year).map((x:any)=><article class="card hof-card"><div class="pos">{x.positionGroup}</div><h3>{x.player}</h3><div class="meta"><span>{x.points?.toLocaleString?.()??x.points} pts</span><span>{x.seasons} seasons</span></div><p>{x.source}</p></article>)}</div></section>)}</section></main><style>.hof-wrap{padding:38px 0 70px}.hof-year{margin-bottom:52px}.year-head{display:flex;align-items:end;gap:10px;margin-bottom:18px}.year-head span{color:var(--muted);font-size:.7rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.year-head h2{margin:0;color:var(--accent);font-size:2.5rem}.hof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.hof-card{position:relative;overflow:hidden}.pos{color:var(--accent);font-size:.65rem;font-weight:900;letter-spacing:.14em}.hof-card h3{margin:8px 0 12px;font-size:1.35rem}.meta{display:flex;gap:14px;color:var(--muted);font-size:.78rem}.hof-card p{margin-bottom:0;color:#aeb5bc;font-size:.85rem}@media(max-width:900px){.hof-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.hof-grid{grid-template-columns:1fr}}</style></BaseLayout>