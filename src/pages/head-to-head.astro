---
import BaseLayout from '../layouts/BaseLayout.astro';
import franchises from '../../data/franchises.json';
import h2h from '../../data/head-to-head.json';
import { teams } from '../lib/teams';
const cards=franchises.map((f:any)=>{const current=teams.find((t:any)=>t.teamId===f.activeTeamId);return{id:f.franchiseId,name:current?.name??`Franchise ${f.franchiseId}`};});
const first=h2h.pairs[0];
---
<BaseLayout title="Head to Head | AMD FFL"><main><section class="page-head"><div class="shell"><div class="eyebrow">Settle it with receipts</div><h1>Head to Head</h1><p>Pick two franchises. The historical record follows the franchise through every team name and owner era.</p></div></section><section class="shell matchup"><div class="picker"><label>FRANCHISE ONE<select id="team-a">{cards.map((c:any)=><option value={c.id}>{c.name}</option>)}</select></label><div class="versus">VS</div><label>FRANCHISE TWO<select id="team-b">{cards.map((c:any)=><option value={c.id} selected={c.id===2}>{c.name}</option>)}</select></label></div><div class="results"><div class="series"><div><span id="name-a">{cards[0].name}</span><strong id="wins-a">{first.overall[0]}</strong><small>WINS</small></div><div class="series-mid"><span>ALL-TIME SERIES</span><b id="series-record">{first.overall.join('-')}</b><small id="meetings">{first.overall.reduce((a:number,b:number)=>a+b,0)} TOTAL MEETINGS</small></div><div><span id="name-b">{cards[1].name}</span><strong id="wins-b">{first.overall[1]}</strong><small>WINS</small></div></div><div class="stat-grid"><article><span>REGULAR SEASON</span><strong id="regular">{first.regular.join('-')}</strong></article><article><span>PLAYOFFS</span><strong id="playoffs">{first.playoffs.join('-')}</strong></article><article><span>WIN PCT.</span><strong id="pct"></strong></article></div><div id="verdict" class="verdict"></div></div><div class="callout"><strong>Names change. The record follows the franchise.</strong><span>Historical team identities are rolled into their franchise slot, so every era counts.</span></div></section>
<script define:vars={{cards,h2h}}>const A=document.querySelector('#team-a'),B=document.querySelector('#team-b'),N=Object.fromEntries(cards.map(x=>[x.id,x.name]));function pair(x,y){let lo=Math.min(x,y),hi=Math.max(x,y),p=h2h.pairs.find(q=>q.a===lo&&q.b===hi);if(!p)return null;if(x===lo)return p;let f=v=>[v[1],v[0],v[2]];return{...p,regular:f(p.regular),playoffs:f(p.playoffs),overall:f(p.overall)}}function rec(v){return v[2]?v.join('-'):`${v[0]}-${v[1]}`}function draw(){let x=+A.value,y=+B.value;if(x===y){y=x===14?13:x+1;B.value=y}let p=pair(x,y);if(!p)return;let [w,l,t]=p.overall,total=w+l+t,pct=total?((w+t*.5)/total*100).toFixed(1)+'%':'—';document.querySelector('#name-a').textContent=N[x];document.querySelector('#name-b').textContent=N[y];document.querySelector('#wins-a').textContent=w;document.querySelector('#wins-b').textContent=l;document.querySelector('#series-record').textContent=rec(p.overall);document.querySelector('#meetings').textContent=total+' TOTAL MEETINGS';document.querySelector('#regular').textContent=rec(p.regular);document.querySelector('#playoffs').textContent=rec(p.playoffs);document.querySelector('#pct').textContent=pct;let d=w-l;document.querySelector('#verdict').textContent=d===0?'DEAD EVEN. NOBODY GETS TO TALK TRASH YET.':d>0?N[x]+' LEADS THE ALL-TIME SERIES BY '+d+'.':N[y]+' LEADS THE ALL-TIME SERIES BY '+Math.abs(d)+'.'}A.addEventListener('change',draw);B.addEventListener('change',draw);draw();</script></main><style>.page-head{background:radial-gradient(circle at 50% 0,rgba(213,169,70,.12),transparent 34%);border-bottom:1px solid var(--line)}.page-head p{max-width:760px;color:var(--muted);font-size:1.05rem;line-height:1.65}.matchup{padding:42px 0 70px}.picker{display:grid;grid-template-columns:1fr 80px 1fr;gap:18px;align-items:end;padding:28px;border:1px solid var(--line);background:#11161b;border-radius:10px}.picker label{display:grid;gap:10px;color:var(--accent);font-size:.65rem;font-weight:900;letter-spacing:.12em}.picker select{padding:15px;border:1px solid #343d47;border-radius:6px;background:#0b1015;color:#fff;font:inherit;font-weight:800}.versus{display:grid;place-items:center;height:51px;font-size:1.4rem;font-weight:900;color:#77828e}.results{margin-top:18px;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#11161b}.series{display:grid;grid-template-columns:1fr 1.2fr 1fr;align-items:center;text-align:center;padding:34px 24px}.series>div{display:grid;gap:5px}.series span,.stat-grid span{color:#8f9aa5;font-size:.68rem;font-weight:900;letter-spacing:.08em}.series strong{font-size:4.4rem;line-height:1;color:var(--accent)}.series-mid b{font-size:2.4rem}.series small{color:#66717c}.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}.stat-grid article{display:grid;gap:8px;padding:24px;text-align:center;background:#0d1217}.stat-grid strong{font-size:1.8rem}.verdict{padding:22px;border-top:1px solid var(--line);color:var(--accent);font-weight:900;text-align:center}.callout{display:flex;gap:14px;margin-top:18px;padding:20px 24px;border-left:3px solid var(--accent);background:#12171c}.callout strong{color:var(--accent)}.callout span{color:var(--muted)}@media(max-width:700px){.picker,.series{grid-template-columns:1fr}.versus{height:auto}.series{gap:22px}.stat-grid{grid-template-columns:1fr}.callout{display:block}}</style></BaseLayout>