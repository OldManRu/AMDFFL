---
import BaseLayout from '../layouts/BaseLayout.astro';
import h2h2025 from '../../data/head-to-head/2025.json';
import h2h2024 from '../../data/head-to-head/2024.json';

const datasets: Record<string, any> = { '2025': h2h2025, '2024': h2h2024 };
const current = h2h2025 as any;
const initialA = 'lamar-trojans';
const initialB = 'simi-valley-pioneers';
---
<BaseLayout title="Head to Head | AMD FFL">
  <main>
    <section class="page-head">
      <div class="shell">
        <div class="eyebrow">Settle it with receipts</div>
        <h1>Head to Head</h1>
        <p>Choose a Head-to-Head archive year and two exact team identities. Only games played under those team names count.</p>
      </div>
    </section>

    <section class="shell matchup">
      <div class="year-row">
        <label>HEAD-TO-HEAD YEAR
          <select id="year-select">
            <option value="2025" selected>2025</option>
            <option value="2024">2024</option>
          </select>
        </label>
        <span id="source-note">Source: {current.source}</span>
      </div>

      <div class="picker">
        <label>TEAM ONE
          <select id="team-a">
            {current.teams.map((team: any) => <option value={team.key} selected={team.key===initialA}>{team.name}</option>)}
          </select>
        </label>
        <div class="versus">VS</div>
        <label>TEAM TWO
          <select id="team-b">
            {current.teams.map((team: any) => <option value={team.key} selected={team.key===initialB}>{team.name}</option>)}
          </select>
        </label>
      </div>

      <div class="results">
        <div class="series">
          <div><span id="name-a">Lamar Trojans</span><strong id="wins-a">3</strong><small>WINS</small></div>
          <div class="series-mid"><span>ALL-TIME SERIES</span><b id="series-record">3-13</b><small id="meetings">16 TOTAL MEETINGS</small></div>
          <div><span id="name-b">Simi Valley Pioneers</span><strong id="wins-b">13</strong><small>WINS</small></div>
        </div>
        <div class="stat-grid">
          <article><span>REGULAR SEASON</span><strong id="regular">3-13</strong></article>
          <article><span>PLAYOFFS</span><strong id="playoffs">0-0</strong></article>
          <article><span>WIN PCT.</span><strong id="pct">18.8%</strong></article>
        </div>
        <div id="verdict" class="verdict">Simi Valley Pioneers LEADS THE ALL-TIME SERIES BY 10.</div>
      </div>

      <div class="callout">
        <strong>Team names matter here.</strong>
        <span>Lamar means Lamar. Simi Valley means Simi Valley. Previous names and franchise eras are not rolled into these records.</span>
      </div>
    </section>

    <script define:vars={{datasets}}>
      const Y=document.querySelector('#year-select');
      const A=document.querySelector('#team-a');
      const B=document.querySelector('#team-b');
      const source=document.querySelector('#source-note');
      const reverse=v=>[v[1],v[0],v[2]];
      const rec=v=>v[2]?v.join('-'):`${v[0]}-${v[1]}`;
      const names=data=>Object.fromEntries(data.teams.map(t=>[t.key,t.name]));

      function getPair(data,x,y){
        const direct=data.pairs.find(p=>p.a===x&&p.b===y);
        if(direct)return direct;
        const flipped=data.pairs.find(p=>p.a===y&&p.b===x);
        if(!flipped)return {regular:[0,0,0],playoffs:[0,0,0],overall:[0,0,0]};
        return {...flipped,regular:reverse(flipped.regular),playoffs:reverse(flipped.playoffs),overall:reverse(flipped.overall)};
      }

      function fillTeams(){
        const data=datasets[Y.value];
        const oldA=A.value,oldB=B.value;
        const options=data.teams.map(t=>`<option value="${t.key}">${t.name}</option>`).join('');
        A.innerHTML=options; B.innerHTML=options;
        const keys=new Set(data.teams.map(t=>t.key));
        A.value=keys.has(oldA)?oldA:(keys.has('lamar-trojans')?'lamar-trojans':data.teams[0].key);
        B.value=keys.has(oldB)&&oldB!==A.value?oldB:(keys.has('simi-valley-pioneers')&&A.value!=='simi-valley-pioneers'?'simi-valley-pioneers':data.teams.find(t=>t.key!==A.value).key);
        source.textContent='Source: '+data.source;
      }

      function draw(){
        const data=datasets[Y.value],N=names(data);
        let x=A.value,y=B.value;
        if(x===y){const alt=data.teams.find(t=>t.key!==x);B.value=alt.key;y=alt.key;}
        const p=getPair(data,x,y);
        const [w,l,t]=p.overall,total=w+l+t;
        const pct=total?((w+t*.5)/total*100).toFixed(1)+'%':'—';
        document.querySelector('#name-a').textContent=N[x];
        document.querySelector('#name-b').textContent=N[y];
        document.querySelector('#wins-a').textContent=w;
        document.querySelector('#wins-b').textContent=l;
        document.querySelector('#series-record').textContent=rec(p.overall);
        document.querySelector('#meetings').textContent=total+' TOTAL MEETINGS';
        document.querySelector('#regular').textContent=rec(p.regular);
        document.querySelector('#playoffs').textContent=rec(p.playoffs);
        document.querySelector('#pct').textContent=pct;
        const d=w-l;
        document.querySelector('#verdict').textContent=d===0?'DEAD EVEN. NOBODY GETS TO TALK TRASH YET.':d>0?N[x]+' LEADS THE ALL-TIME SERIES BY '+d+'.':N[y]+' LEADS THE ALL-TIME SERIES BY '+Math.abs(d)+'.';
      }

      Y.addEventListener('change',()=>{fillTeams();draw()});
      A.addEventListener('change',draw);
      B.addEventListener('change',draw);
      draw();
    </script>
  </main>

  <style>
    .page-head{background:radial-gradient(circle at 50% 0,rgba(213,169,70,.12),transparent 34%);border-bottom:1px solid var(--line)}
    .page-head p{max-width:760px;color:var(--muted);font-size:1.05rem;line-height:1.65}
    .matchup{padding:42px 0 70px}
    .year-row{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:14px}
    .year-row label,.picker label{display:grid;gap:10px;color:var(--accent);font-size:.65rem;font-weight:900;letter-spacing:.12em}
    .year-row select,.picker select{padding:16px 18px;border:1px solid #343d47;border-radius:6px;background:#0b1015;color:#fff;font-family:inherit;font-size:1.25rem;font-weight:800}
    .year-row select{min-width:180px}
    .year-row span{color:var(--muted);font-size:.8rem}
    .picker{display:grid;grid-template-columns:1fr 80px 1fr;gap:18px;align-items:end;padding:28px;border:1px solid var(--line);background:#11161b;border-radius:10px}
    .versus{display:grid;place-items:center;height:56px;font-size:1.4rem;font-weight:900;color:#77828e}
    .results{margin-top:18px;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#11161b}
    .series{display:grid;grid-template-columns:1fr 1.2fr 1fr;align-items:center;text-align:center;padding:34px 24px}
    .series>div{display:grid;gap:5px}
    .series span,.stat-grid span{color:#8f9aa5;font-size:.68rem;font-weight:900;letter-spacing:.08em}
    .series strong{font-size:4.4rem;line-height:1;color:var(--accent)}
    .series-mid b{font-size:2.4rem}.series small{color:#66717c}
    .stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}
    .stat-grid article{display:grid;gap:8px;padding:24px;text-align:center;background:#0d1217}
    .stat-grid strong{font-size:1.8rem}
    .verdict{padding:22px;border-top:1px solid var(--line);color:var(--accent);font-weight:900;text-align:center}
    .callout{display:flex;gap:14px;margin-top:18px;padding:20px 24px;border-left:3px solid var(--accent);background:#12171c}
    .callout strong{color:var(--accent)}.callout span{color:var(--muted)}
    @media(max-width:700px){.year-row{display:grid}.picker,.series{grid-template-columns:1fr}.versus{height:auto}.series{gap:22px}.stat-grid{grid-template-columns:1fr}.callout{display:block}}
  </style>
</BaseLayout>
