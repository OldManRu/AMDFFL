---
import BaseLayout from '../layouts/BaseLayout.astro';
import headlines from '../../data/legacy-records/headlines.json';
---
<BaseLayout title="Records | AMD FFL">
<main>
<section class="page-head"><div class="shell"><div class="eyebrow">Receipts, preserved forever</div><h1>The Record Book</h1><p class="muted">Greatness, disaster, dominance, collapse — all reduced to numbers so nobody gets to rewrite history later.</p></div></section>
<section class="shell records-grid">
{headlines.map((r:any)=><article class="card record-card"><span class="eyebrow">{r.record}</span><strong>{r.value}</strong><p>{r.detail}</p></article>)}
</section>
</main>
<style>.records-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;padding:34px 0 60px}.record-card strong{display:block;margin:8px 0;font-size:2.2rem}.record-card p{margin:0;color:var(--muted)}@media(max-width:700px){.records-grid{grid-template-columns:1fr}}</style>
</BaseLayout>
