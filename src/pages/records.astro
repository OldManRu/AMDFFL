---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/records.css';
import headlines from '../../data/legacy-records/headlines.json';
import franchises from '../../data/franchises.json';
import { teams } from '../lib/teams';
import { standings } from '../lib/standings';
const shameLabels = ['Fewest Wins, Season','Most Consecutive Losses','Lowest Score, Game','Least Points, Season','Most Lopsided Game'];
const glory = headlines.filter((r:any) => !shameLabels.includes(r.record));
const shame = headlines.filter((r:any) => shameLabels.includes(r.record));
const mods = import.meta.glob('../../data/championships/*.json',{eager:true});
const bowls = Object.values(mods).flatMap((m:any)=>m.default ?? m);
const sourceMods = import.meta.glob('../../data/source/franchises/**/*.json',{eager:true});
const sourceEntries = Object.values(sourceMods).flatMap((m:any)=>{
  const d=m.default??m;
  return Array.isArray(d.entries)?d.entries:[d];
});
const teamById = new Map(teams.map((t:any)=>[t.teamId,t]));
const currentSeason = Math.max(...bowls.map((b:any)=>b.season));
const currentBowl = bowls.find((b:any)=>b.season===currentSeason);
const leagueStartYear = 2006;
const seasonYear = (season:number) => leagueStartYear + season - 1;
const explicitStartYears: Record<string, number> = {
  'deckerville-eagles': 2024,
  'illini-west-chargers': 2025,
  'excelsior-springs-tigers': 2022,
};
const secondSundayOfFebruary = (season:number) => {
  const year = seasonYear(season) + 1;
  const first = new Date(Date.UTC(year,1,1));
  const firstSunday = 1 + ((7 - first.getUTCDay()) % 7);
  const day = firstSunday + 7;
  return `${year}-02-${String(day).padStart(2,'0')}`;
};
const standingsStartYear = (team:any) => {
  if(!team?.teamId) return null;
  const row = standings.find((r:any)=>Array.isArray(r.teamIds) && r.teamIds.includes(team.teamId));
  const match = String(row?.years??'').match(/(20\d{2})/);
  return match ? Number(match[1]) : null;
};
const recordedStartYear = (team:any) => {
  if(!team?.historicalId) return null;
  const entry = sourceEntries.find((e:any)=>String(e.slot??e.historicalId??'')===String(team.historicalId));
  const text = String(entry?.narrative??'');
  const patterns = [
    /first year\s*\((20\d{2})\)/i,
    /(?:joined|started|took over|picked up|entered|came into|came in|began)[^.]{0,90}?(20\d{2})/i,
    /(?:before|for) the (20\d{2}) season/i
  ];
  for(const pattern of patterns){
    const match=text.match(pattern);
    if(match) return Number(match[1]);
  }
  return null;
};
const leagueArchiveStart = `${leagueStartYear}-01-01`;
const legacy = franchises.map((f:any)=>{
  const lineage = teams.filter((t:any)=>t.franchiseId===f.franchiseId);
  const ids = new Set(lineage.map((t:any)=>t.teamId));
  const wins = bowls.filter((b:any)=>ids.has(b.winnerTeamId));
  const losses = bowls.filter((b:any)=>ids.has(b.loserTeamId));
  const lastTitle = wins.length ? Math.max(...wins.map((b:any)=>b.season)) : null;
  const current = teamById.get(f.activeTeamId) as any;
  const activeWins = current?.teamId ? bowls.filter((b:any)=>b.winnerTeamId===current.teamId) : [];
  const rawActiveLastTitle = activeWins.length ? Math.max(...activeWins.map((b:any)=>b.season)) : null;
  const formerNames = [...new Set(lineage.filter((t:any)=>t.teamId!==f.activeTeamId).map((t:any)=>t.name).filter(Boolean))];
  const startYear = explicitStartYears[current?.teamId] ?? standingsStartYear(current) ?? recordedStartYear(current);
  const activeLastTitle = rawActiveLastTitle && (!startYear || seasonYear(rawActiveLastTitle) >= startYear) ? rawActiveLastTitle : null;
  const daysSinceDate = activeLastTitle ? secondSundayOfFebruary(activeLastTitle) : startYear ? `${startYear}-01-01` : leagueArchiveStart;
  const reigning = currentBowl ? currentBowl.winnerTeamId===current?.teamId : false;
  return {teamId:current?.teamId,name:current?.name ?? `Franchise ${f.franchiseId}`,titles:wins.length,appearances:wins.length+losses.length,lastTitle,activeLastTitle,drought:lastTitle===null?null:currentSeason-lastTitle,startYear,daysSinceDate,reigning,formerNames};
}).sort((a,b)=>b.titles-a.titles || b.appearances-a.appearances || a.name.localeCompare(b.name));
const droughts = [...legacy].sort((a,b)=>(b.drought ?? 999)-(a.drought ?? 999));
---
<BaseLayout title="Records | AMD FFL"><main class="records-page">
<section class="page-head"><div class="shell records-intro"><div class="eyebrow">Receipts, preserved forever</div><h1>The Record Book</h1><p class="muted">Greatness, disaster, dominance, collapse — all reduced to numbers so nobody gets to rewrite history later.</p></div></section>

<section class="shell section-shell"><div class="section-title"><div><div class="eyebrow">League benchmarks</div><h2>Marks of Greatness</h2></div><p>The numbers everybody wants attached to their name. Until somebody breaks them, these are the standards.</p></div><div class="records-grid">{glory.map((r:any)=><article class="card record-card"><span class="eyebrow">{r.record}</span><strong>{r.value}</strong><p>{r.detail}</p></article>)}</div></section>

<section class="standings-zone"><div class="shell section-shell"><div class="section-title"><div><div class="eyebrow">The long view</div><h2>All-Time Standings</h2></div><p>Twenty seasons have a way of separating a hot streak from a body of work.</p></div><div class="standings-table"><div class="standings-row standings-head"><span>#</span><span>Team</span><span>W-L</span></div>{standings.map((r:any)=><div class="standings-row"><span>{r.sourceRank}</span><strong>{r.sourceLabel.replace(/^X-/,'')}</strong><span>{r.wins}-{r.losses}</span></div>)}</div></div></section>

<section class="legacy-zone"><div class="shell section-shell"><div class="section-title"><div><div class="eyebrow">Cathedral Bowl history</div><h2>Championship Legacy</h2></div><p>Appearances are nice. Titles are what survive the group chat.</p></div><div class="legacy-table"><div class="legacy-row head"><span>Franchise</span><span>Titles</span><span>Apps</span><span>Last Title</span></div>{legacy.map((r:any)=><div class="legacy-row"><strong>{r.name}</strong><span>{r.titles}</span><span>{r.appearances}</span><span>{r.lastTitle ? `S${r.lastTitle}` : '—'}</span></div>)}</div><p class="note">Seasons 7–8 remain pending in the archive, so championship totals will update when those results are restored.</p></div></section>

<section class="drought-zone"><div class="shell section-shell"><div class="section-title"><div><div class="eyebrow">Current suffering</div><h2>Championship Drought Watch</h2></div><p>A completely necessary public service for franchises wondering exactly how long it has been.</p></div><div class="drought-grid">{droughts.map((r:any)=><article class="card drought-card"><div class="drought-main"><strong>{r.drought===null?'NEVER':r.drought}</strong><span>{r.drought===null?'TITLE ON RECORD':r.drought===1?'SEASON':'SEASONS'}</span><h3>{r.name}</h3><p>{r.lastTitle ? `Last title: Season ${r.lastTitle}` : r.startYear ? `In the league since ${r.startYear}. Still waiting.` : 'No championship currently recorded.'}</p></div>{r.formerNames?.length > 0 && <aside class="drought-lineage" aria-label={`Former team identities for ${r.name}`}><span>FORMER IDENTITIES</span><div>{r.formerNames.map((name:string)=><em>{name}</em>)}</div></aside>}</article>)}</div>
<div class="days-since-block"><div class="days-since-head"><div><div class="eyebrow">Because seasons weren't specific enough</div><h2>Days Since Last Championship</h2></div><p>Now the suffering can be measured with unnecessary precision.</p></div><div class="days-since-grid">{droughts.map((r:any)=><article class:list={['days-since-card',{reigning:r.reigning}]} data-team-id={r.teamId}><span class="days-label">{r.reigning?'REIGNING CHAMPION':'DAYS SINCE LAST TITLE'}</span><strong class="days-counter" data-reigning={r.reigning?'true':undefined} data-since={r.daysSinceDate}>{r.reigning?'0':'—'}</strong><h3>{r.name}</h3><p>{r.reigning ? `Season ${currentSeason} champion · Title currently held` : r.activeLastTitle ? `Season ${r.activeLastTitle} champion` : r.startYear ? `Waiting since joining in ${r.startYear}.` : 'Still waiting for the first one.'}</p></article>)}</div><p class="days-note">The reigning champion stays at 0 days until the next Cathedral Bowl crowns a new winner. All other championship dates use the second Sunday of February; teams without a title under their current identity start from their first season.</p></div>
</div></section>

<section id="hall-of-shame" class="shame-zone"><div class="shell"><div class="section-title"><div><div class="eyebrow">Permanent record • No appeals</div><h2>The Hall of Shame</h2><p class="tagline">Records nobody was trying to set.</p></div><p>History isn't only written by the winners. Sometimes it is written by whoever managed to lose the hardest.</p></div><div class="records-grid shame-grid">{shame.map((r:any)=><article class="card shame-card"><span class="eyebrow">Inducted for historic ineptitude</span><h3>{r.record}</h3><strong>{r.value}</strong><p>{r.detail}</p></article>)}</div><p class="warning">Rebranding does not erase the record. The archive remembers.</p></div></section>
</main>
<script is:inline>
  (() => {
    const today = new Date();
    today.setHours(0,0,0,0);
    document.querySelectorAll('.days-counter[data-since]').forEach((el) => {
      if (el.getAttribute('data-reigning') === 'true') {
        el.textContent = '0';
        return;
      }
      const since = new Date(`${el.getAttribute('data-since')}T00:00:00`);
      const days = Math.max(0, Math.floor((today.getTime() - since.getTime()) / 86400000));
      el.textContent = days.toLocaleString();
    });
  })();
</script>
</BaseLayout>
