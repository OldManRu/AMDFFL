---
import BaseLayout from '../layouts/BaseLayout.astro';
import { awards } from '../lib/awards';
const labels:any={mvp:'League MVP',oroy:'Offensive Rookie',droy:'Defensive Rookie',manager_of_the_year:'Manager of the Year',dpoy:'Defensive Player of the Year'};
const order=['mvp','oroy','droy','manager_of_the_year','dpoy'];
const grouped=awards.reduce((acc:any,a:any)=>{(acc[a.category]??=[]).push(a);return acc;},{});
const groups=order.filter((category)=>grouped[category]?.length).map((category)=>({category,items:grouped[category].sort((a:any,b:any)=>b.season-a.season)}));
---
<BaseLayout title="Awards | AMD FFL"><main><section class="page-head"><div class="shell"><div class="eyebrow">League honors</div><h1>Awards</h1><p class="muted">Twenty seasons of MVPs, rookies, defenders, and managers who managed to look competent for at least one year.</p></div></section><section class="shell award-groups">{groups.map((g:any)=><section class="award-group"><h2>{labels[g.category]}</h2><div class="award-grid">{g.items.map((a:any)=><article class="card award-card"><span class="eyebrow">Season {a.season}</span><strong>{a.player??a.raw}</strong>{a.teamId&&<small>{a.teamId.replaceAll('-',' ')}</small>}</article>)}</div></section>)}</section></main><style>.award-groups{padding:38px 0 60px}.award-group{margin-bottom:46px}.award-group h2{text-transform:uppercase;font-size:1.8rem}.award-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.award-card strong{display:block;margin:8px 0;text-transform:capitalize}.award-card small{color:var(--muted);text-transform:capitalize}@media(max-width:700px){.award-grid{grid-template-columns:1fr}}</style></BaseLayout>