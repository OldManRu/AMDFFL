---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/awards.css';
import { awards } from '../lib/awards';
import { teams } from '../lib/teams';

const order = [
  'league_mvp',
  'offensive_rookie',
  'defensive_rookie',
  'manager_of_the_year',
  'defensive_player_of_the_year'
];

const labels:any = {
  league_mvp:'League MVP',
  offensive_rookie:'Offensive Rookie',
  defensive_rookie:'Defensive Rookie',
  manager_of_the_year:'Manager of the Year',
  defensive_player_of_the_year:'Defensive Player of the Year'
};

const descriptions:any = {
  league_mvp:'The season’s standard-bearer. One name gets the top line.',
  offensive_rookie:'First-year offensive players who arrived ready to cause problems.',
  defensive_rookie:'First-year defenders who made themselves impossible to ignore.',
  manager_of_the_year:'For the person who made enough correct decisions to deserve documentation.',
  defensive_player_of_the_year:'The defenders who wrecked plans, ruined Sundays, and earned the hardware.'
};

const grouped = awards.reduce((acc:any,a:any)=>{
  (acc[a.category] ??= []).push(a);
  return acc;
},{});

const teamName = (id:string) => teams.find((team:any)=>team.teamId===id)?.name ?? id.replaceAll('-',' ');

const groups = order
  .filter((category)=>grouped[category]?.length)
  .map((category)=>({
    category,
    items: grouped[category].sort((a:any,b:any)=>b.season-a.season)
  }));
---
<BaseLayout title="Awards | AMD FFL"><main class="awards-page">
<section class="page-head"><div class="shell"><div class="eyebrow">League honors</div><h1>Awards</h1><p class="muted">Twenty seasons of MVPs, rookies, defenders, and managers who managed to look competent for at least one year.</p></div></section>
<section class="shell award-groups">
{groups.map((g:any)=><section class="award-group" data-category={g.category}>
  <div class="award-group-head"><div class="award-seal" aria-hidden="true"></div><div><h2>{labels[g.category]}</h2><p>{descriptions[g.category]}</p></div></div>
  <div class="award-grid">
    {g.items.map((a:any,index:number)=><article class:list={['card','award-card',{latest:index===0}]} data-season={`S${a.season}`}>
      <span class="season">Season {a.season}</span>
      <strong>{a.player??a.raw}</strong>
      {a.teamId&&<small>{teamName(a.teamId)}</small>}
    </article>)}
  </div>
</section>)}
</section>
</main></BaseLayout>
