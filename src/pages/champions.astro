---
import BaseLayout from '../layouts/BaseLayout.astro';
import { teams } from '../lib/catalog';
import crestonGames from '../../data/creston-bowl.json';

const modules = import.meta.glob('../../data/championships/*.json', { eager: true, import: 'default' });
const cathedralGames = Object.values(modules).flat().sort((a: any, b: any) => b.season - a.season);
const creston = [...crestonGames].sort((a: any, b: any) => b.season - a.season);
const teamName = (id: string) => teams.find((team) => team.teamId === id)?.name ?? id;
---
<BaseLayout title="Champions | AMD FFL">
  <main class="shell champions-page">
    <header class="page-head">
      <div class="eyebrow">Twenty seasons. Two trophies.</div>
      <h1>Championship History</h1>
      <p class="muted">Glory at the top. Infamy at the bottom. Every title game counts.</p>
    </header>

    <section class="bowl-section">
      <div class="section-head"><div class="eyebrow">The one everybody wants</div><h2>Cathedral Bowl</h2><p class="muted">League championship history from Super Bowl I through the modern Cathedral Bowl era.</p></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Season</th><th>Champion</th><th>Score</th><th>Runner-up</th><th>Score</th></tr></thead>
          <tbody>
            {cathedralGames.map((game: any) => (
              <tr>
                <td>{game.season}</td>
                <td><strong>{teamName(game.winnerTeamId)}</strong></td>
                <td>{game.winnerScore}</td>
                <td>{teamName(game.loserTeamId)}</td>
                <td>{game.loserScore}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="bowl-section creston-section">
      <div class="section-head"><div class="eyebrow">Records nobody puts on the refrigerator</div><h2>Creston Bowl</h2><p class="muted">Born as the Toilet Bowl, promoted to the JaMarcus Russell Bowl, and eventually renamed for the franchise that made losing an art form.</p></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Season</th><th>Bowl</th><th>Champion</th><th>Score</th><th>Runner-up</th><th>Score</th></tr></thead>
          <tbody>
            {creston.map((game: any) => (
              <tr>
                <td>{game.season}</td>
                <td class="bowl-name">{game.name}</td>
                <td><strong>{teamName(game.winnerTeamId)}</strong></td>
                <td>{game.winnerScore}</td>
                <td>{teamName(game.loserTeamId)}</td>
                <td>{game.loserScore}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
  <style>
    .champions-page{padding-bottom:70px}.page-head{margin-bottom:38px}.bowl-section{margin-top:34px}.section-head{margin-bottom:18px}.section-head h2{margin:.2rem 0 .45rem;font-size:2rem;text-transform:uppercase}.section-head p{max-width:760px;line-height:1.6}.creston-section{margin-top:58px;padding-top:42px;border-top:1px solid var(--line)}.bowl-name{color:var(--accent);font-size:.78rem;font-weight:900;letter-spacing:.04em;white-space:nowrap}@media(max-width:700px){.table-wrap{overflow-x:auto}table{min-width:720px}}
  </style>
</BaseLayout>
