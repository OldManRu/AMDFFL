---
import BaseLayout from '../layouts/BaseLayout.astro';
const latest = {
  season:20, year:2025,
  barry:{score:198.84,players:[
    ['QB','Matthew Stafford','East Grand',29.25],['RB','Christian McCaffrey','Deckerville',13.7],['WR','Amon St Brown','Deckerville',24.9],['WR',"Ja'Marr Chase",'East Grand',23.6],['O','Jahmyr Gibbs','Mervo',20.3],['O','Rico Dowdle','Lamar',3],['TE','Jake Ferguson','Roosevelt',1.5],['K','Jason Myers','Simi Valley',4],['HC','Sean Payton','Lamar',6.76],['DL','Danielle Hunter','Mervo',11.41],['DL','Montez Sweat','Lamar',10.1],['LB','Foyesade Oluokun','Deckerville',13],['LB','Jordyn Brooks','East Grand',13],['DB','Marcus Jones','Roosevelt',10.32],['DB','Tyson Campbell','Mervo',4],['D','Kaden Ellis','Lamar',10]
  ]},
  emmitt:{score:172.03,players:[
    ['QB','Caleb Williams','Excelsior',18.7],['RB','Jonathan Taylor','Leto',5.9],['WR','Jaxon Smith-Njigba','Sandusky',14.4],['WR','Puka Nacua','Excelsior',26],['O','James Cook','Excelsior',1.5],['O','Deebo Samuel','Ridge',6.1],['TE','Trey McBride','Sandusky',13.5],['K',"Ka'imi Fairbairn","Lee's Summit",26],['HC','Kyle Shanahan','Pekin',-1],['DL','Myles Garrett','Sandusky',7.26],['DL','Byron Young','Excelsior',8.26],['LB','Devin White','Ridge',16.41],['LB','Cedric Gray','Leto',11],['DB','Talanoa Hufanga','Illini',5],['DB','Nick Cross',"Lee's Summit",9],['D','Payton Wilson','Ridge',4]
  ]}
};
const history=[
  {season:19,year:2024,winner:'Barry Division',winnerScore:254.99,loser:'Emmitt Division',loserScore:238.57},
  {season:16,year:2021,winner:'Barry Division',winnerScore:252.4,loser:'Emmitt Division',loserScore:195.85},
  {season:15,year:2020,winner:'Emmitt Division',winnerScore:228.5,loser:'Barry Division',loserScore:203.4},
  {season:14,year:2019,winner:'Emmitt Division',winnerScore:232.85,loser:'Barry Division',loserScore:192.05},
  {season:11,year:2016,winner:'Emmitt Division',winnerScore:218.5,loser:'Barry Division',loserScore:188},
  {season:7,year:2012,winner:'Emmitt Division',winnerScore:203.1,loser:'Barry Division',loserScore:199.8}
];
---
<BaseLayout title="Pro Bowls | AMD FFL">
<main>
<section class="page-head"><div class="shell"><div class="eyebrow">The best of both divisions</div><h1>Pro Bowls</h1><p>The annual Barry vs. Emmitt showcase — the league's best players, assembled from the original AMD FFL archive.</p></div></section>
<section class="shell pro-wrap">
  <div class="season-head"><div><span>2025 · SEASON 20</span><h2>Barry Division takes the latest one</h2></div><div class="final"><strong>{latest.barry.score}</strong><b>—</b><strong>{latest.emmitt.score}</strong></div></div>
  <div class="division-grid">
    <article><header><h3>Barry Division</h3><strong>{latest.barry.score}</strong></header><div class="lineup">{latest.barry.players.map((p)=><div class="player"><b>{p[0]}</b><span>{p[1]} <small>· {p[2]}</small></span><strong>{p[3]}</strong></div>)}</div></article>
    <article><header><h3>Emmitt Division</h3><strong>{latest.emmitt.score}</strong></header><div class="lineup">{latest.emmitt.players.map((p)=><div class="player"><b>{p[0]}</b><span>{p[1]} <small>· {p[2]}</small></span><strong>{p[3]}</strong></div>)}</div></article>
  </div>
  <section class="history"><div class="eyebrow">From the original archive</div><h2>Past Pro Bowls</h2><div class="history-grid">{history.map((g)=><article><span>SEASON {g.season} · {g.year}</span><div><strong>{g.winner}</strong><b>{g.winnerScore}</b></div><div class="loser"><strong>{g.loser}</strong><b>{g.loserScore}</b></div></article>)}</div><p class="archive-note">The original WordPress export contains the full historical Pro Bowl lineups. Those source records are being preserved as-is as the archive is normalized.</p></section>
</section>
</main>
<style>
.page-head{background:radial-gradient(circle at 50% 0,rgba(213,169,70,.12),transparent 34%);border-bottom:1px solid var(--line)}.page-head p{max-width:760px;color:var(--muted);font-size:1.05rem;line-height:1.65}.pro-wrap{padding:42px 0 72px}.season-head{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:18px}.season-head span,.history-grid>article>span{color:var(--accent);font-size:.7rem;font-weight:900;letter-spacing:.1em}.season-head h2{margin:.35rem 0 0}.final{display:flex;align-items:center;gap:14px;font-size:2.2rem;color:var(--accent)}.final b{color:#59636e}.division-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.division-grid article{border:1px solid var(--line);border-radius:10px;background:#11161b;overflow:hidden}.division-grid header{display:flex;justify-content:space-between;align-items:center;padding:20px 22px;border-bottom:1px solid var(--line);background:#0d1217}.division-grid header h3{margin:0}.division-grid header strong{font-size:1.8rem;color:var(--accent)}.lineup{display:grid}.player{display:grid;grid-template-columns:42px 1fr auto;gap:10px;align-items:center;padding:11px 18px;border-bottom:1px solid rgba(255,255,255,.055)}.player:last-child{border-bottom:0}.player>b{color:var(--accent);font-size:.7rem}.player span{font-weight:750}.player small{color:var(--muted);font-weight:500}.player>strong{font-variant-numeric:tabular-nums}.history{margin-top:42px}.history h2{margin-top:6px}.history-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.history-grid article{padding:18px;border:1px solid var(--line);border-radius:8px;background:#10151a}.history-grid article div{display:flex;justify-content:space-between;gap:12px;margin-top:13px}.history-grid article div>b{color:var(--accent)}.history-grid .loser{color:var(--muted)}.archive-note{margin-top:18px;color:var(--muted);font-size:.9rem}@media(max-width:800px){.division-grid{grid-template-columns:1fr}.history-grid{grid-template-columns:1fr 1fr}.season-head{display:block}.final{margin-top:14px}}@media(max-width:520px){.history-grid{grid-template-columns:1fr}.player{grid-template-columns:34px 1fr auto}}
</style>
</BaseLayout>
