const history=[season19,{season:16,year:2021,winner:'Barry Division',winnerScore:252.4,loser:'Emmitt Division',loserScore:195.85},{season:15,year:2020,winner:'Emmitt Division',winnerScore:228.5,loser:'Barry Division',loserScore:203.4},{season:14,year:2019,winner:'Emmitt Division',winnerScore:232.85,loser:'Barry Division',loserScore:192.05},{season:11,year:2016,winner:'Emmitt Division',winnerScore:218.5,loser:'Barry Division',loserScore:188},{season:7,year:2012,winner:'Emmitt Division',winnerScore:203.1,loser:'Barry Division',loserScore:199.8}];
---
<BaseLayout title="Pro Bowls | AMD FFL"><main><section class="page-head"><div class="shell"><div class="eyebrow">The best of both divisions</div><h1>Pro Bowls</h1><p>The annual Barry vs. Emmitt showcase — the league's best players, assembled from the original AMD FFL archive.</p></div></section><section class="shell pro-wrap"><div class="season-head"><div><span>2025 · SEASON 20</span><h2>Barry Division takes the latest one</h2></div><div class="final"><strong>{latest.barry.score}</strong><b>—</b><strong>{latest.emmitt.score}</strong></div></div><div class="division-grid"><article><header><h3>Barry Division</h3><strong>{latest.barry.score}</strong></header><div class="lineup">{latest.barry.players.map((p)=><div class="player"><b>{p[0]}</b><span>{p[1]} <small>· {p[2]}</small></span><strong>{p[3]}</strong></div>)}</div></article><article><header><h3>Emmitt Division</h3><strong>{latest.emmitt.score}</strong></header><div class="lineup">{latest.emmitt.players.map((p)=><div class="player"><b>{p[0]}</b><span>{p[1]} <small>· {p[2]}</small></span><strong>{p[3]}</strong></div>)}</div></article></div><section class="history"><div class="eyebrow">From the original archive</div><h2>Past Pro Bowls</h2><div class="history-grid">{history.map((g:any)=><button class="history-card" data-season={g.season}><span>SEASON {g.season} · {g.year}</span><div><strong>{g.winner}</strong><b>{g.winnerScore}</b></div><div class="loser"><strong>{g.loser}</strong><b>{g.loserScore}</b></div><small>{g.barry?'VIEW FULL LINEUPS':'FULL LINEUP BEING NORMALIZED'}</small></button>)}</div></section></section><dialog id="pro-modal"><button class="close" aria-label="Close">×</button><div id="modal-content"></div></dialog><script define:vars={{history}}>const modal=document.querySelector('#pro-modal'),content=document.querySelector('#modal-content');const row=p=>`<div class="player"><b>${p[0]}</b><span>${p[1]} <small>· ${p[2]}</small></span><strong>${p[3]}</strong></div>`;function openGame(g){if(g.barry){content.innerHTML=`<div class="modal-head"><span>SEASON ${g.season} · ${g.year}</span><h2>${g.winner} wins ${g.winnerScore}–${g.loserScore}</h2></div><div class="division-grid modal-grid"><article><header><h3>Barry Division</h3><strong>${g.barry.score}</strong></header><div class="lineup">${g.barry.players.map(row).join('')}</div></article><article><header><h3>Emmitt Division</h3><strong>${g.emmitt.score}</strong></header><div class="lineup">${g.emmitt.players.map(row).join('')}</div></article></div>`}else{content.innerHTML=`<div class="modal-head"><span>SEASON ${g.season} · ${g.year}</span><h2>${g.winner} ${g.winnerScore}–${g.loserScore}</h2><p>The original player-level lineup is preserved in the archive and is still being normalized into this view.</p></div>`}modal.showModal()}document.querySelectorAll('.history-card').forEach(b=>b.addEventListener('click',()=>openGame(history.find(g=>g.season===+b.dataset.season))));document.querySelector('.close').addEventListener('click',()=>modal.close());modal.addEventListener('click',e=>{if(e.target===modal)modal.close()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.open)modal.close()});</script></main><style>.page-head{background:radial-gradient(circle at 50% 0,rgba(213,169,70,.12),transparent 34%);border-bottom:1px solid var(--line)}.page-head p{max-width:760px;color:var(--muted);font-size:1.05rem;line-height:1.65}.pro-wrap{padding:42px 0 72px}.season-head{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:18px}.season-head span,.history-card>span,.modal-head span{color:var(--accent);font-size:.7rem;font-weight:900;letter-spacing:.1em}.season-head h2{margin:.35rem 0 0}.final{display:flex;align-items:center;gap:14px;font-size:2.2rem;color:var(--accent)}.final b{color:#59636e}.division-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.division-grid article{border:1px solid var(--line);border-radius:10px;background:#11161b;overflow:hidden}.division-grid header{display:flex;justify-content:space-between;align-items:center;padding:20px 22px;border-bottom:1px solid var(--line);background:#0d1217}.division-grid header h3{margin:0}.division-grid header strong{font-size:1.8rem;color:var(--accent)}.lineup{display:grid}.player{display:grid;grid-template-columns:42px 1fr auto;gap:10px;align-items:center;padding:11px 18px;border-bottom:1px solid rgba(255,255,255,.055)}.player:last-child{border-bottom:0}.player>b{color:var(--accent);font-size:.7rem}.player span{font-weight:750}.player small{color:var(--muted);font-weight:500}.player>strong{font-variant-numeric:tabular-nums}.history{margin-top:42px}.history h2{margin-top:6px}.history-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.history-card{padding:18px;border:1px solid var(--line);border-radius:8px;background:#10151a;color:inherit;text-align:left;font:inherit;cursor:pointer;transition:.18s ease}.history-card:hover{transform:translateY(-2px);border-color:#6b592e}.history-card div{display:flex;justify-content:space-between;gap:12px;margin-top:13px}.history-card div>b{color:var(--accent)}.history-card .loser{color:var(--muted)}.history-card>small{display:block;margin-top:15px;color:var(--accent);font-size:.62rem;font-weight:900;letter-spacing:.08em}dialog{width:min(1120px,94vw);max-height:90vh;padding:0;border:1px solid var(--line);border-radius:12px;background:#0b1015;color:#fff;overflow:auto}dialog::backdrop{background:rgba(0,0,0,.82)}.close{position:sticky;top:12px;float:right;z-index:3;margin:12px 12px 0 0;width:38px;height:38px;border:1px solid var(--line);border-radius:50%;background:#111820;color:#fff;font-size:1.7rem;cursor:pointer}.modal-head{padding:30px 32px 16px}.modal-head h2{margin:.4rem 0}.modal-head p{color:var(--muted)}.modal-grid{padding:0 32px 32px}@media(max-width:800px){.division-grid{grid-template-columns:1fr}.history-grid{grid-template-columns:1fr 1fr}.season-head{display:block}.final{margin-top:14px}.modal-grid{padding:0 18px 20px}.modal-head{padding:24px 18px 12px}}@media(max-width:520px){.history-grid{grid-template-columns:1fr}.player{grid-template-columns:34px 1fr auto}}</style></BaseLayout>