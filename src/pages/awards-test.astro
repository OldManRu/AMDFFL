---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/awards-test.css';
import '../styles/awards-test-mvp.css';
import { awards } from '../lib/awards';
import { teams } from '../lib/teams';

const order = [
  'league_mvp',
  'offensive_rookie',
  'defensive_rookie',
  'manager_of_the_year',
  'defensive_player_of_the_year'
];

const labels:any = {
  league_mvp:'League MVP',
  offensive_rookie:'Offensive Rookie',
  defensive_rookie:'Defensive Rookie',
  manager_of_the_year:'Manager of the Year',
  defensive_player_of_the_year:'Defensive Player of the Year'
};

const shortLabels:any = {
  league_mvp:'MVP',
  offensive_rookie:'Offensive Rookie',
  defensive_rookie:'Defensive Rookie',
  manager_of_the_year:'Manager of the Year',
  defensive_player_of_the_year:'DPOY'
};

const trophyArt:any = {
  manager_of_the_year:'/images/awards/trophy-manager.svg',
  defensive_player_of_the_year:'/images/awards/trophy-dpoy.svg'
};

const renderedArt:any = {
  league_mvp:'/images/awards/trophy-mvp-render.webp',
  offensive_rookie:'/images/awards/trophy-offensive-rookie-render.webp?v=2',
  defensive_rookie:'/images/awards/trophy-defensive-rookie-render.webp?v=1'
};

const descriptions:any = {
  league_mvp:'The league’s top individual honor.',
  offensive_rookie:'The first-year offensive player who announced his arrival loudest.',
  defensive_rookie:'The rookie defender who made Sundays miserable immediately.',
  manager_of_the_year:'For the manager whose decisions survived the group chat and the standings.',
  defensive_player_of_the_year:'The defender who spent the season wrecking otherwise reasonable plans.'
};

const grouped = awards.reduce((acc:any,a:any)=>{
  (acc[a.category] ??= []).push(a);
  return acc;
},{});

const teamName = (id:string) => teams.find((team:any)=>team.teamId===id)?.name ?? id.replaceAll('-',' ');

const groups = order
  .filter((category)=>grouped[category]?.length)
  .map((category)=>({
    category,
    items: grouped[category].sort((a:any,b:any)=>b.season-a.season)
  }));
---
<BaseLayout title="Awards Trophy Concept | AMD FFL">
<main class="awards-test-page">
  <section class="trophy-hero">
    <div class="hero-light hero-light-left"></div>
    <div class="hero-light hero-light-right"></div>
    <div class="shell trophy-hero-inner">
      <div class="eyebrow">AMD FFL · Awards concept lab</div>
      <h1>AMD FFL <span>Awards</span></h1>
      <p>Legends are built here.</p>
      <div class="hero-rule"></div>
      <div class="concept-note">TEST PAGE · CURRENT AWARDS PAGE UNCHANGED</div>
    </div>
  </section>

  <section class="shell trophy-gallery" aria-label="AMD FFL award trophies">
    {groups.map((g:any)=>{
      const latest = g.items[0];
      const isMvp = g.category === 'league_mvp';
      const isOffensiveRookie = g.category === 'offensive_rookie';
      const isDefensiveRookie = g.category === 'defensive_rookie';
      const isRendered = isMvp || isOffensiveRookie || isDefensiveRookie;
      return <article class:list={['trophy-display',{ 'rendered-mvp': isMvp, 'rendered-award': isRendered, 'rendered-offensive-rookie': isOffensiveRookie, 'rendered-defensive-rookie': isDefensiveRookie }]} data-category={g.category}>
        <header class="trophy-title">
          <span class="award-kicker">AMD FFL HARDWARE</span>
          <h2>{labels[g.category]}</h2>
          <p>{descriptions[g.category]}</p>
        </header>

        <div class="trophy-stage">
          <div class="spotlight" aria-hidden="true"></div>
          {isRendered
            ? <div class="rendered-trophy-wrap"><img class="rendered-trophy-art" src={renderedArt[g.category]} alt={`AMD FFL ${labels[g.category]} trophy`} /></div>
            : <img class="trophy-art" src={trophyArt[g.category]} alt="" loading="lazy" />}

          {!isRendered && <div class="trophy-nameplate" aria-hidden="true">
            <strong>{shortLabels[g.category]}</strong>
            <span>AMD FFL</span>
          </div>}

          {!isRendered && <div class="current-winner">
            <span>Defending honoree</span>
            <strong>{latest.player ?? latest.raw}</strong>
            <small>Season {latest.season}{latest.teamId ? ` · ${teamName(latest.teamId)}` : ''}</small>
          </div>}

          <div class="trophy-base">
            <div class="plate-window" tabindex="0" aria-label={`${labels[g.category]} winners. Scroll to see all winners.`}>
              <div class="plate-stack">
                {g.items.map((a:any,index:number)=><div class:list={['name-plate',{current:index===0}]}>
                  <span class="plate-season">S{a.season}</span>
                  <span class="plate-name">{a.player ?? a.raw}</span>
                  <span class="plate-team">{a.teamId ? teamName(a.teamId) : 'AMD FFL'}</span>
                </div>)}
              </div>
            </div>
            <div class="scroll-cue"><span>SCROLL WINNERS</span><b>↕</b></div>
          </div>
        </div>
      </article>
    })}
  </section>

  <section class="shell awards-footer-line" aria-hidden="true">
    <span></span><strong>SAME LEAGUE. HIGHER STANDARDS.</strong><span></span>
  </section>
</main>
</BaseLayout>
