---
import BaseLayout from '../layouts/BaseLayout.astro';
import franchises from '../../data/franchises.json';
import { teams } from '../lib/teams';
import '../styles/franchises.css';
const cards=franchises.map((franchise:any)=>{const lineage=teams.filter((team:any)=>team.franchiseId===franchise.franchiseId);const current=lineage.find((team:any)=>team.teamId===franchise.activeTeamId);return{...franchise,current,lineage};});
---
<BaseLayout title="Franchises | AMD FFL"><main class="franchise-page">
<section class="page-head franchise-head"><div class="shell"><div class="eyebrow">The league never forgets</div><h1>Franchise Lineage</h1><p>Fourteen franchise slots. Forty-five team identities. Two decades of relocations, rebrands, ownership changes, and names that seemed like a good idea at the time.</p><div class="franchise-summary"><span><b>14</b> active franchise slots</span><span><b>{teams.length}</b> identities archived</span><span>Helmet gallery coming online</span></div></div></section>
<section class="shell franchise-grid">{cards.map((card:any)=><a class="franchise-card" href={`/franchises/${card.franchiseId}`}><div class="helmet-stage"><div class="helmet-placeholder">F{String(card.franchiseId).padStart(2,'0')}</div>{card.current&&<img class="helmet-img" src={`/teams/${card.current.teamId}-helmet.webp`} alt={`${card.current.name} helmet`} loading="lazy" onerror="this.style.display='none'" />}</div><div class="franchise-body"><div class="franchise-number">F{String(card.franchiseId).padStart(2,'0')}</div><div class="status">ACTIVE FRANCHISE</div><h2>{card.current?.name??`Franchise ${card.franchiseId}`}</h2><div class="lineage-count">{card.lineage.length} {card.lineage.length===1?'identity':'identities'} on record</div><div class="lineage">{card.lineage.map((team:any,index:number)=><div class:list={['lineage-item',{current:team.teamId===card.activeTeamId}]}><span>{String(index+1).padStart(2,'0')}</span><strong>{team.name}</strong>{team.teamId===card.activeTeamId&&<small>CURRENT</small>}</div>)}</div><div class="open">OPEN FRANCHISE ARCHIVE →</div></div></a>)}</section>
<section class="shell franchise-foot"><strong>Names change. Receipts don't.</strong><span>Each franchise archive preserves its identity lineage, original write-ups, championship history, and eventually every helmet that represented it.</span></section>
</main></BaseLayout>
