---
import BaseLayout from '../layouts/BaseLayout.astro';
import franchises from '../../data/franchises.json';
import { teams } from '../lib/teams';
const cards=franchises.map((franchise:any)=>{const lineage=teams.filter((team:any)=>team.franchiseId===franchise.franchiseId);const current=lineage.find((team:any)=>team.teamId===franchise.activeTeamId);return{...franchise,current,lineage};});
---
<BaseLayout title="Franchises | AMD FFL"><main>
<section class="page-head franchise-head"><div class="shell"><div class="eyebrow">The league never forgets</div><h1>Franchise Lineage</h1><p>Fourteen franchise slots. Forty-five team identities. Two decades of relocations, rebrands, ownership changes, and names that seemed like a good idea at the time.</p></div></section>
<section class="shell franchise-grid">{cards.map((card:any)=><a class="franchise-card" href={`/franchises/${card.franchiseId}`}><div class="franchise-number">F{String(card.franchiseId).padStart(2,'0')}</div><div class="status">ACTIVE FRANCHISE</div><h2>{card.current?.name??`Franchise ${card.franchiseId}`}</h2><div class="lineage-count">{card.lineage.length} {card.lineage.length===1?'identity':'identities'} on record</div><div class="lineage">{card.lineage.map((team:any,index:number)=><div class:list={['lineage-item',{current:team.teamId===card.activeTeamId}]}><span>{String(index+1).padStart(2,'0')}</span><strong>{team.name}</strong>{team.teamId===card.activeTeamId&&<small>CURRENT</small>}</div>)}</div><div class="open">VIEW FRANCHISE HISTORY →</div></a>)}</section>
<section class="shell franchise-foot"><strong>Names change. Receipts don't.</strong><span>Click any franchise to open the original write-ups, lineage, and growing historical record.</span></section>
</main><style>
.franchise-head{background:radial-gradient(circle at 80% 20%,rgba(213,169,70,.12),transparent 28%);border-bottom:1px solid var(--line)}.franchise-head p{max-width:760px;color:var(--muted);font-size:1.05rem;line-height:1.65}.franchise-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;padding:38px 0}.franchise-card{position:relative;overflow:hidden;padding:26px;border:1px solid var(--line);border-radius:10px;background:linear-gradient(145deg,#171c22,#101419);color:inherit;text-decoration:none}.franchise-card:hover{border-color:#6b592e;transform:translateY(-2px)}.franchise-number{position:absolute;right:22px;top:18px;color:#2b343e;font-size:3.6rem;font-weight:900}.status,.open{color:var(--accent);font-size:.65rem;font-weight:900;letter-spacing:.12em}.franchise-card h2{position:relative;margin:8px 0 5px;max-width:80%;font-size:2rem;line-height:1;text-transform:uppercase}.lineage-count{margin-bottom:20px;color:#77828e;font-size:.8rem}.lineage{border-top:1px solid var(--line)}.lineage-item{display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #242b33}.lineage-item span{color:#59636e;font-size:.65rem}.lineage-item strong{font-size:.85rem}.lineage-item small{color:var(--accent);font-size:.55rem}.open{margin-top:18px}.franchise-foot{display:flex;gap:16px;align-items:center;margin-bottom:58px;padding:20px 24px;border-left:3px solid var(--accent);background:#12171c}.franchise-foot strong{white-space:nowrap;color:var(--accent);text-transform:uppercase}.franchise-foot span{color:var(--muted)}@media(max-width:760px){.franchise-grid{grid-template-columns:1fr}.franchise-foot{display:block}.franchise-foot span{display:block;margin-top:7px}}
</style></BaseLayout>
