---
import '../styles/global.css';
const { title = 'AMD FFL', description = 'The historical archive of AMD Fantasy Football League.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="theme-color" content="#071019" /><title>{title}</title></head>
<body>
<header class="site-header"><div class="shell nav">
<a class="brand" href="/"><img class="brand-mark" src="/amdffl-mark.svg" alt="AMD FFL shield" /><span class="brand-wordmark"><b>AMD FFL</b><small>Fantasy Football League</small></span></a>
<nav class="nav-links" aria-label="Primary">
<a class={path==='/'?'active':''} href="/">Home</a><a href="/franchises">Franchises</a><a href="/champions">Champions</a><a href="/pro-bowls">Pro Bowls</a><a href="/records">Records</a><a href="/hall-of-fame">Hall of Fame</a><a href="/awards">Awards</a><a href="/head-to-head">Head to Head</a><a href="/posters">Posters</a><a href="/memorial">Memorial</a>
</nav><div class="est"><small>EST.</small><strong>2006</strong></div>
</div></header>
<slot />
<footer class="footer"><div class="shell footer-inner">★ <strong>ONE LEAGUE. ONE TROPHY. ETERNAL BRAGGING RIGHTS.</strong> ★</div><div class="shell footer-meta">AMD FFL historical archive · Serious records, unserious people.</div></footer>
{path==='/pro-bowls' && <script is:inline src="/scripts/pro-bowls-normalized.js"></script>}
<style is:global>
  .brand{display:flex;align-items:center;gap:10px;min-width:max-content}
  .brand-mark{width:48px;height:56px;object-fit:contain;filter:drop-shadow(0 8px 14px rgba(0,0,0,.32))}
  .brand-wordmark{display:grid;gap:1px;line-height:1}
  .brand-wordmark b{color:var(--accent);font-family:Impact,Haettenschweiler,"Arial Narrow Bold",sans-serif;font-size:1.45rem;letter-spacing:.055em}
  .brand-wordmark small{color:#aeb7c1;font-size:.54rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
  @media(max-width:720px){.brand-mark{width:42px;height:49px}.brand-wordmark small{display:none}}
</style>
</body></html>
