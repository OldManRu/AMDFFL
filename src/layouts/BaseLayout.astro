---
import '../styles/global.css';
import '../styles/header-brand.css';
import '../styles/stats-polish.css';
const { title = 'AMD FFL', description = 'The historical archive of AMD Fantasy Football League.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="theme-color" content="#071019" /><link rel="icon" type="image/webp" href="/images/amdffl-brand-shield.webp" /><title>{title}</title></head>
<body>
<header class="site-header"><div class="shell nav">
<a class="brand" href="/" aria-label="AMD Fantasy Football League home"><img class="brand-mark" src="/images/amdffl-brand-shield.webp" alt="AMD FFL" /></a>
<nav class="nav-links" aria-label="Primary">
<a class={path==='/'?'active':''} href="/">Home</a><a href="/franchises">Franchises</a><a href="/champions">Champions</a><a href="/pro-bowls">Pro Bowls</a><a href="/records">Records</a><a href="/hall-of-fame">Hall of Fame</a><a href="/awards">Awards</a><a href="/head-to-head">Head to Head</a><a href="/posters">Posters</a><a href="/memorial">Memorial</a>
</nav><div class="est"><small>EST.</small><strong>2006</strong></div>
</div></header>
<slot />
<footer class="footer"><div class="shell footer-inner">★ <strong>ONE LEAGUE. ONE TROPHY. ETERNAL BRAGGING RIGHTS.</strong> ★</div><div class="shell footer-meta">AMD FFL historical archive · Serious records, unserious people.</div></footer>
{path==='/pro-bowls' && <script is:inline src="/scripts/pro-bowls-normalized.js"></script>}
</body></html>
