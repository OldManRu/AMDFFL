---
import '../styles/global.css';
import '../styles/header-brand.css';
import '../styles/stats-polish.css';
import '../styles/site-polish.css';
const { title = 'AMD FFL', description = 'The historical archive of AMD Fantasy Football League.' } = Astro.props;
const path = Astro.url.pathname;
const navItems = [
  ['Home','/'],
  ['Franchises','/franchises'],
  ['Champions','/champions'],
  ['Pro Bowls','/pro-bowls'],
  ['Records','/records'],
  ['Hall of Fame','/hall-of-fame'],
  ['Awards','/awards'],
  ['Head to Head','/head-to-head'],
  ['Posters','/posters'],
  ['Memorial','/memorial']
];
const isActive = (href:string) => href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="theme-color" content="#071019" /><link rel="icon" type="image/webp" href="/images/amdffl-brand-shield.webp" />{path==='/pro-bowls' && <link rel="stylesheet" href="/styles/pro-bowls.css" />}<title>{title}</title></head>
<body>
<header class="site-header"><div class="shell nav">
<a class="brand" href="/" aria-label="AMD Fantasy Football League home"><img class="brand-mark" src="/images/amdffl-brand-shield.webp" alt="AMD FFL" /></a>
<nav class="nav-links" aria-label="Primary">
{navItems.map(([label,href]) => {
  const active = isActive(href);
  return <a class={active?'active':''} aria-current={active?'page':undefined} href={href}>{label}</a>;
})}
</nav><div class="header-founding" aria-label="Established 2006"><span></span><b>EST. 2006</b><span></span></div>
</div></header>
<slot />
<footer class="footer"><div class="shell footer-inner">★ <strong>ONE LEAGUE. ONE TROPHY. ETERNAL BRAGGING RIGHTS.</strong> ★</div><div class="shell footer-meta">AMD FFL historical archive · Serious records, unserious people.</div></footer>
{path==='/pro-bowls' && <script is:inline src="/scripts/pro-bowls-normalized.js"></script>}
</body></html>
